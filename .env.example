# Copy to .env (ignored by Git). Load with: atlaspm system doctor --env-file .env
# Values are literal data: no shell evaluation or ${VARIABLE} interpolation.
# OS/vault environment variables take precedence. Never commit filled credentials.

# Public official sources: SEC requires a descriptive contact header.
ATLASPM_SEC_USER_AGENT=
# FRED requires a free API key; each series has its own license.
FRED_API_KEY=
# Comma-separated series explicitly licensed for local retention and local AI.
ATLASPM_FRED_LOCAL_AI_SERIES=

# Optional paid historical options, flow and credit feeds.
MASSIVE_API_KEY=
UW_TOKEN=
ATLASPM_UW_RIGHTS=
ATLASPM_UW_RIGHTS_RETENTION=0
ATLASPM_UNUSUAL_WHALES_LOCAL_AI_RIGHTS=0
ATLASPM_UW_MAX_REQUESTS=10
XPRESSAPI_TOKEN=
XPRESSAPI_USERNAME=
XPRESSAPI_PASSWORD=
XPRESSAPI_TOKEN_EXPIRES_AT=
ATLASPM_XPRESSAPI_RIGHTS=
ATLASPM_XPRESSAPI_RIGHTS_RETENTION=0
ATLASPM_XPRESSAPI_LOCAL_AI_RIGHTS=0
ATLASPM_XPRESSAPI_MAX_REQUESTS=10
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
ATLASPM_FINRA_RIGHTS=
ATLASPM_FINRA_RIGHTS_RETENTION=0
ATLASPM_FINRA_MAX_REQUESTS=10

# Licensed file delivery: contract references, never fabricated public endpoints.
ATLASPM_YAHOO_NEWS_RIGHTS=
ATLASPM_YAHOO_NEWS_RIGHTS_RETENTION=0
ATLASPM_YAHOO_FINANCE_LOCAL_AI_RIGHTS=0
ATLASPM_BLOOMBERG_NEWS_RIGHTS=
ATLASPM_BLOOMBERG_NEWS_RIGHTS_RETENTION=0
ATLASPM_BLOOMBERG_LOCAL_AI_RIGHTS=0
ATLASPM_INVESTMENT_BANKS_RIGHTS=
ATLASPM_INVESTMENT_BANKS_RIGHTS_RETENTION=0
ATLASPM_INVESTMENT_BANKS_LOCAL_AI_RIGHTS=0
ATLASPM_INVESTMENT_BANKS_RESEARCH_RIGHTS=
ATLASPM_INVESTMENT_BANKS_RESEARCH_RIGHTS_RETENTION=0
ATLASPM_INVESTMENT_BANKS_RESEARCH_LOCAL_AI_RIGHTS=0
ATLASPM_BLOOMBERG_RESEARCH_RIGHTS=
ATLASPM_BLOOMBERG_RESEARCH_RIGHTS_RETENTION=0
ATLASPM_BLOOMBERG_RESEARCH_LOCAL_AI_RIGHTS=0

# IBKR authentication remains in the existing local Paper gateway profile.
# Configure account/TLS through the existing ibkr-paper-sync --configure command.
ATLASPM_IBKR_MARKET_DATA_RIGHTS=
ATLASPM_IBKR_MARKET_DATA_RIGHTS_RETENTION=0
ATLASPM_IBKR_LOCAL_AI_RIGHTS=0

# Optional external evidence-only models. The unified monitor never calls them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Runtime loader refuses enabling orders or external AI through this file.
ATLASPM_ALLOW_EXTERNAL_AI=0
ATLASPM_ALLOW_PAPER_ORDERS=0
